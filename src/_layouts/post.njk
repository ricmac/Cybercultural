---
layout: base
schema: blog
preloads:
  href: '/assets/fonts/robotomono/robotomono-variablefont_wght-webfont.woff2'
  as: 'font'
  type: 'font/woff2'
  crossorigin: true
---

<article class="region blog" data-pagefind-body>
  <div class="wrapper flow prose">
    <h1>{{ title }}</h1>    
    <p class="lede">{{ description | safe }}</p>
    <span class="author">By <a href="/about/">Richard MacManus</a> | 
    {% set definedDate = date %} {% include "partials/date.njk" %}
    {#- Shown month-and-year, but the datetime attribute keeps the exact day. -#}
    {%- if lastUpdated %} | Updated <time datetime="{{ lastUpdated | toIsoString }}">{{ lastUpdated | formatDate('MMM YYYY') }}</time>{% endif -%}
    {% if tags %} | Tags:&nbsp;
    {%- set nonPostsTags = [] -%}
    {%- for tag in tags -%}
      {%- if tag != "posts" -%}
        {%- set nonPostsTags = nonPostsTags.concat([tag]) -%}
      {%- endif -%}
    {%- endfor -%}

    {%- for tag in nonPostsTags -%}
      {#- Labels live in src/_data/taxonomy.js, shared with the post schema. -#}
      {%- set tagTitle = taxonomy.tags[tag].label -%}

      {%- if tagTitle -%}
        <a href="/{{ tag | slug }}">{{ tagTitle }}</a>
      {%- else -%}
        <a href="/tags/{{ tag | slug }}">{{ tag }}</a>
      {%- endif -%}

      {%- if not loop.last %}, {% endif -%}
    {%- endfor -%}
    </span>
    {% endif %}

    {{ content | safe }}
  </div>
</article>

<div class="wrapper flow prose post-extras blog">
<hr>
<div class="author-box">
  <img src="/assets/images/richard-macmanus.jpg" alt="Richard MacManus" width="400" height="400" sizes="5rem">
  <p><strong><a href="/about/">Richard MacManus</a></strong> founded the pioneering tech blog ReadWriteWeb (2003-2012) and wrote the Web 2.0 memoir <a href="/p/book-release-bubbleblog/"><em>Bubble Blog</em></a>. He is now Head of Editorial at Latent Space.</p>
</div>
<form
  action="https://buttondown.email/api/emails/embed-subscribe/ricmac"
  method="post"
  target="popupwindow"
  onsubmit="window.open('https://buttondown.email/ricmac', 'popupwindow')"
  class="embeddable-buttondown-form">
  <label for="bd-email">Cybercultural is a blog about internet history and its cultural impact. Subscribe:</label>
  <input type="email" name="email" id="bd-email" placeholder="Your email address" autocomplete="email" />
  <input type="submit" value="Submit" />
</form>

<script src='https://storage.ko-fi.com/cdn/widget/Widget_2.js'></script><script>kofiwidget2.init('Support Cybercultural', '#b80103', 'F1F61AI58P');kofiwidget2.draw();</script>

