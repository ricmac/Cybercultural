<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": "https://cybercultural.com{{ page.url }}",
    "url": "https://cybercultural.com{{ page.url }}",
    "name": {{ (title or meta.siteName) | toJsonLd | safe }},
    "description": {{ (description or meta.siteDescription) | toJsonLd | safe }},
    "isPartOf": {
      "@id": "{{ meta.url }}#website"
    },
    "inLanguage": "{{ meta.locale }}"
  }
</script>
